# PagerMCP server, packaged as a Bastille template.
#
# Same application and the same environment configuration as the Docker image,
# but installed with pkg inside a FreeBSD jail. Set the service variables (and
# arbitrary extra env via pagermcp_env) in /etc/rc.conf, e.g.:
#   pagermcp_port="8080"
#   pagermcp_env="MESSAGE_TTL_DAYS=7 NTFY_URL=https://ntfy.example"
#
# Apply with:  bastille template <jail> pagermcp/server
# Override the version with: --arg PAGER_VERSION=0.10.0

ARG PAGER_VERSION=0.10.0
# Build number reported from /version. Docker tags use their sequential build
# number (v0.10.0 = 52, latest = 53); a Bastille install uses the next number
# (54) so the install type is distinguishable from the build alone.
ARG PAGER_BUILD=54
ARG PAGER_PORT=8080
ARG PAGER_DATA_DIR=/var/db/pagermcp/data
# Optional: a reachable DNS server. Needed when the host's /etc/resolv.conf
# points at a loopback resolver (127.0.0.1) that the jail cannot use, otherwise
# the pkg/fetch steps below fail.
ARG PAGER_NAMESERVER=

CMD test -z "${PAGER_NAMESERVER}" || echo "nameserver ${PAGER_NAMESERVER}" > /etc/resolv.conf

# Dependencies come from pkg (no pip, no build).
PKG python312 py312-aiohttp py312-markdown py312-cryptography py312-sqlite3

# Dedicated service account and data directory.
CMD pw groupadd -n pagermcp 2>/dev/null || true
CMD pw useradd -n pagermcp -g pagermcp -d /var/db/pagermcp -s /usr/sbin/nologin -c "PagerMCP" 2>/dev/null || true
CMD mkdir -p /var/db/pagermcp/data /usr/local/lib/pagermcp
CMD chown -R pagermcp:pagermcp /var/db/pagermcp

# Fetch the application source for this version and install it under /usr/local/lib/pagermcp.
CMD fetch -q -o /tmp/pagermcp.tgz "https://github.com/Ofloo/PagerMCP/archive/refs/tags/v${PAGER_VERSION}.tar.gz"
CMD tar -xzf /tmp/pagermcp.tgz -C /tmp
CMD cp -R /tmp/PagerMCP-${PAGER_VERSION}/pager_mcp /usr/local/lib/pagermcp/
CMD cp /tmp/PagerMCP-${PAGER_VERSION}/README.md /tmp/PagerMCP-${PAGER_VERSION}/RFC-0001-pager-protocol.md /usr/local/lib/pagermcp/
CMD cp -R /tmp/PagerMCP-${PAGER_VERSION}/sample /usr/local/lib/pagermcp/
CMD rm -rf /tmp/pagermcp.tgz /tmp/PagerMCP-${PAGER_VERSION}

# rc.d script and launcher.
OVERLAY overlay/
CMD chmod 755 /usr/local/etc/rc.d/pagermcp /usr/local/bin/pagermcp

SYSRC pagermcp_enable=YES
SYSRC pagermcp_port=${PAGER_PORT}
SYSRC pagermcp_build=${PAGER_BUILD}
SYSRC pagermcp_data_dir=${PAGER_DATA_DIR}

CMD service pagermcp restart >/dev/null 2>&1 </dev/null &
