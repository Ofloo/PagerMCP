# PagerMCP environment (the same variables the Docker image accepts).
# For `podman run --env-file` copy this to pagermcp.env and edit it, or set the
# values in the Quadlet unit / a drop-in.
MODE=server
PORT=8080
DATA_DIR=/data
MAILBOX_TTL_DAYS=30
MESSAGE_TTL_DAYS=7
MAX_MESSAGES_PER_MAILBOX=128
MAX_MESSAGE_BYTES=65536
WAIT_TIMEOUT_SECONDS=90
SUBSCRIPTION_TTL_DAYS=30
SUBSCRIPTION_WARN_DAYS=3
CLEANUP_INTERVAL_SECONDS=3600
# WEBCLIENT_TTL_DAYS=7
# NTFY_URL=https://ntfy.example
# NTFY_TOKEN=
# FCM_CREDENTIALS=/secrets/fcm.json
# FCM_PROJECT_ID=
# FCM_INCLUDE_PAYLOAD=0
# Rotated debug access log (UUIDs masked, daily rotation, default 3 days kept):
# PAGER_LOG_FILE=/var/log/pagermcp/access.log
# PAGER_LOG_RETENTION_DAYS=3
# Allow push to trusted internal/LAN distributors (SSRF guard, empty = none).
# Blocked by default: loopback, link-local (169.254/16), private (10/8,
# 172.16/12, 192.168/16), CGNAT (100.64/10), doc-ranges, multicast, reserved.
# PUSH_ENDPOINT_ALLOWLIST=up.internal.example,10.13.40.0/24
# P2P: verplicht GPG-versleutelde bestemmings-UUID (standaard aan):
# P2P_GPG_ENABLED=1
# Federatie: one-sided peer mesh (leeg = standalone):
# PAGER_PEERS=http://peer1:8080,http://peer2:8080
# PAGER_PUBLIC_URL=https://pager.example.com
# PAGER_PEER_BLACKLIST=192.0.2.10
