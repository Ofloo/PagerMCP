# PagerMCP environment (the same variables the Docker image accepts).
# For `podman run --env-file` copy this to pagermcp.env and edit it, or set the
# values in the Quadlet unit / a drop-in.
MODE=server
PORT=8080
DATA_DIR=/data
MAILBOX_TTL_DAYS=30
MESSAGE_TTL_DAYS=7
MAX_MESSAGES_PER_MAILBOX=128
MAX_MESSAGE_BYTES=65536
WAIT_TIMEOUT_SECONDS=90
SUBSCRIPTION_TTL_DAYS=30
SUBSCRIPTION_WARN_DAYS=3
CLEANUP_INTERVAL_SECONDS=3600
# WEBCLIENT_TTL_DAYS=7
# NTFY_URL=https://ntfy.example
# NTFY_TOKEN=
# FCM_CREDENTIALS=/secrets/fcm.json
# FCM_PROJECT_ID=
# FCM_INCLUDE_PAYLOAD=0
