[Unit]
Description=PagerMCP server
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=pagermcp
# Same OCI image as the Docker deployment (pulled from Docker Hub).
Image=docker.io/ofloo/pagermcp:v0.10.0
PublishPort=8080:8080
Environment=MODE=server
Environment=PORT=8080
Environment=DATA_DIR=/data
Environment=MAILBOX_TTL_DAYS=30
Environment=MESSAGE_TTL_DAYS=7
Environment=MAX_MESSAGES_PER_MAILBOX=128
Environment=MAX_MESSAGE_BYTES=65536
Environment=WAIT_TIMEOUT_SECONDS=90
Environment=SUBSCRIPTION_TTL_DAYS=30
Environment=SUBSCRIPTION_WARN_DAYS=3
Environment=CLEANUP_INTERVAL_SECONDS=3600
Volume=pagermcp_data:/data:Z
# Extra settings (retention, ntfy, fcm, ...) can be added here or in a drop-in,
# e.g. /etc/containers/systemd/pagermcp.container.d/extra.conf:
#   [Container]
#   Environment=NTFY_URL=https://ntfy.example
#   Environment=FCM_CREDENTIALS=/run/secrets/fcm.json
#   Secret=fcm_json,type=mount,target=fcm.json

[Service]
Restart=always

[Install]
WantedBy=default.target
